import { db } from '../database/connection';

/**
 * Enterprise Standard: Base Repository
 * Rule: Implements shared logic for Tenant-Aware repositories.
 */
export class BaseRepository<T> {
  constructor(protected tableName: string) {}

  /**
   * Enterprise Standard: Find All (Scoped to current Search Path)
   */
  async findAll(): Promise<T[]> {
    const { rows } = await db.query(`SELECT * FROM ${this.tableName}`);
    return rows;
  }

  async findById(id: string): Promise<T | null> {
    const { rows } = await db.query(`SELECT * FROM ${this.tableName} WHERE id = $1`, [id]);
    return rows[0] || null;
  }
}
