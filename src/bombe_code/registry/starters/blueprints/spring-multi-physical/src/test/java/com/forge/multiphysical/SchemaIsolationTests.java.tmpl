package com.forge.multiphysical;

import com.forge.multiphysical.tenancy.TenantContext;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class SchemaIsolationTests {

    @AfterEach
    void tearDown() {
        TenantContext.clear();
    }

    @Test
    void testPhysicalSchemaResolution() {
        assertEquals("public", TenantContext.getTenantId());
        TenantContext.setTenantId("tenant_acme");
        assertEquals("tenant_acme", TenantContext.getTenantId());
        TenantContext.clear();
        assertEquals("public", TenantContext.getTenantId());
    }
}
