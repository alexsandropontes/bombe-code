import { Client } from 'pg';
import bcrypt from 'bcrypt';
import * as dotenv from 'dotenv';
dotenv.config();

const bootstrap = async () => {
  const dbName = process.env.DB_NAME || 'forge_db_logical';
  const masterConfig = { host: process.env.DB_HOST, port: 5432, user: process.env.DB_USER, password: process.env.DB_PASSWORD, database: 'postgres' };

  try {
    const master = new Client(masterConfig); await master.connect();
    const res = await master.query("SELECT 1 FROM pg_database WHERE datname = $1", [dbName]);
    if (res.rowCount === 0) await master.query(`CREATE DATABASE ${dbName}`);
    await master.end();

    const client = new Client({ ...masterConfig, database: dbName }); await client.connect();
    
    // Tabela única com tenant_id para isolamento lógico
    await client.query(`CREATE TABLE IF NOT EXISTS tenants (id UUID PRIMARY KEY DEFAULT gen_random_uuid(), name VARCHAR(255), slug VARCHAR(100) UNIQUE)`);
    await client.query(`CREATE TABLE IF NOT EXISTS users (id UUID PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id UUID REFERENCES tenants(id), email VARCHAR(255) UNIQUE, password_hash VARCHAR(255), roles JSONB DEFAULT '["USER"]')`);
    
    const tr = await client.query(`INSERT INTO tenants (name, slug) VALUES ('Default Corp', 'default') ON CONFLICT DO NOTHING RETURNING id`);
    if (tr.rows.length > 0) {
      const hash = await bcrypt.hash('password', 10);
      await client.query(`INSERT INTO users (tenant_id, email, password_hash, roles) VALUES ($1, 'admin@forge.local', $2, '["ADMIN"]') ON CONFLICT DO NOTHING`, [tr.rows[0].id, hash]);
    }
    console.log('[BOOTSTRAP] Banco Lógico configurado.');
    await client.end();
  } catch (e) { console.error(e); process.exit(1); }
};
bootstrap();
