import React, { createContext, useContext, useState, useEffect } from 'react';
import api from '../services/api';

export interface User { id: string; email: string; first_name: string; roles: string[]; tenant_slug: string; }
interface AuthContextProps { user: User | null; isAuthenticated: boolean; isLoading: boolean; login: (e: string, p: string) => Promise<void>; logout: () => void; }

const AuthContext = createContext<AuthContextProps | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<User | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    const check = async () => {
      try {
        if(localStorage.getItem('auth_token')) {
            const res = await api.get('/api/dashboard'); // Rota protegida teste
            setUser(res.data.user);
        }
      } catch (e) { localStorage.removeItem('auth_token'); } finally { setIsLoading(false); }
    };
    check();
  }, []);

  const login = async (email: string, password: string) => {
    try {
      const discovery = await api.post('/auth/discovery', { email });
      const validation = await api.post('/auth/login', { email, password, tenant_slug: discovery.data.tenant_slug });
      localStorage.setItem('auth_token', validation.data.token);
      setUser(validation.data.user);
    } catch (err: any) { alert(err.response?.data?.message || 'Erro no login'); }
  };

  const logout = () => { localStorage.removeItem('auth_token'); setUser(null); };

  return <AuthContext.Provider value={{ user, isAuthenticated: !!user, isLoading, login, logout }}>{!isLoading && children}</AuthContext.Provider>;
};
export const useAuth = () => { const ctx = useContext(AuthContext); if (!ctx) throw new Error("No AuthContext"); return ctx; };
