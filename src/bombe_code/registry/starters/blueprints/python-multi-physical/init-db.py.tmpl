import psycopg2
from psycopg2 import sql
import os
import bcrypt
from dotenv import load_dotenv

load_dotenv()

def bootstrap():
    db_name = os.getenv("DB_NAME", "forge_db_python")
    conn = psycopg2.connect(host=os.getenv("DB_HOST"), user=os.getenv("DB_USER"), password=os.getenv("DB_PASSWORD"), database="postgres")
    conn.autocommit = True
    cur = conn.cursor()
    
    cur.execute("SELECT 1 FROM pg_database WHERE datname = %s", (db_name,))
    if not cur.fetchone():
        cur.execute(sql.Identifier("CREATE DATABASE", db_name))
    
    cur.close(); conn.close()
    
    # Conexão real
    conn = psycopg2.connect(host=os.getenv("DB_HOST"), user=os.getenv("DB_USER"), password=os.getenv("DB_PASSWORD"), database=db_name)
    cur = conn.cursor()
    cur.execute("CREATE SCHEMA IF NOT EXISTS admin")
    cur.execute("CREATE TABLE IF NOT EXISTS admin.tenants (id UUID PRIMARY KEY DEFAULT gen_random_uuid(), name TEXT, tenant_slug TEXT UNIQUE)")
    # ... (Resto do bootstrap similar ao Node)
    print("[BOOTSTRAP] Python Database Ready.")
    conn.commit(); cur.close(); conn.close()

if __name__ == "__main__": bootstrap()
