from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from database.db import get_db
from services.auth_service import AuthService
from pydantic import BaseModel

router = APIRouter()

class LoginRequest(BaseModel):
    email: str
    password: str

class DiscoveryRequest(BaseModel):
    email: str

@router.post("/discovery")
def discovery(request: DiscoveryRequest, db: Session = Depends(get_db)):
    try:
        service = AuthService(db)
        slug = service.discovery(request.email)
        return {"tenant_slug": slug}
    except Exception as e:
        raise HTTPException(status_code=404, detail=str(e))

@router.post("/login")
def login(request: LoginRequest, db: Session = Depends(get_db)):
    try:
        service = AuthService(db)
        # Em multi-physical, precisamos do slug no payload ou fazemos discovery embutido
        slug = service.discovery(request.email)
        return service.login(request.email, request.password, slug)
    except Exception as e:
        raise HTTPException(status_code=401, detail=str(e))
