package repositories

import (
	"database/sql"
	"fmt"
)

type BaseRepository struct {
	DB        *sql.DB
	TableName string
}

func (r *BaseRepository) FindAll(tenantID string) (*sql.Rows, error) {
	query := fmt.Sprintf("SELECT * FROM %s WHERE tenant_id = $1", r.TableName)
	return r.DB.Query(query, tenantID)
}
