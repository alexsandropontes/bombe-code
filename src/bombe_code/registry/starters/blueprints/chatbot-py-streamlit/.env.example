# OpenAI API Configuration
# Leave OPENAI_BASE_URL empty to use official OpenAI API
# Set OPENAI_BASE_URL for compatible APIs (OpenRouter, DeepSeek, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gemini API Configuration
# If both OPENAI_API_KEY and GEMINI_API_KEY are set, OpenAI takes precedence
GEMINI_API_KEY=
