from fastapi import FastAPI, Request, HTTPException, BackgroundTasks
from fastapi.responses import JSONResponse
import os
from dotenv import load_dotenv
import logging

from webhook.verify import verify_webhook
from webhook.incoming import handle_webhook
from services.whatsapp_service import WhatsAppCloudAPI

load_dotenv()

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = FastAPI(
    title="WhatsApp BFF - Backend for Frontend",
    description="WhatsApp Cloud API Integration Layer",
    version="1.0.0"
)

# Initialize WhatsApp Cloud API client
whatsapp_api = WhatsAppCloudAPI(
    access_token=os.getenv("WHATSAPP_ACCESS_TOKEN"),
    phone_number_id=os.getenv("WHATSAPP_PHONE_NUMBER_ID"),
    api_version=os.getenv("WHATSAPP_API_VERSION", "v18.0")
)

@app.get("/health")
def health_check():
    """Health check endpoint for monitoring"""
    return {
        "status": "UP",
        "service": "WhatsApp BFF",
        "version": "1.0.0"
    }

@app.get("/webhook")
async def webhook_verify(request: Request):
    """
    Webhook verification endpoint for WhatsApp Cloud API

    Meta will send a GET request with:
    - hub.mode: 'subscribe'
    - hub.challenge: random string
    - hub.verify_token: your verify token

    Returns the hub.challenge to verify ownership
    """
    return await verify_webhook(request)

@app.post("/webhook")
async def webhook_receive(request: Request, background_tasks: BackgroundTasks):
    """
    Webhook endpoint to receive messages from WhatsApp Cloud API

    Receives POST requests when:
    - Messages are sent to your WhatsApp number
    - Message status changes (sent, delivered, read)
    """
    try:
        # Process webhook in background to respond quickly to Meta
        background_tasks.add_task(handle_webhook, await request.json(), whatsapp_api)
        return JSONResponse(content={"status": "accepted"}, status_code=200)
    except Exception as e:
        logger.error(f"Error processing webhook: {str(e)}")
        return JSONResponse(content={"status": "error"}, status_code=500)

@app.post("/api/send")
async def send_message(request: Request):
    """
    Send a message to a WhatsApp number

    Request body:
    {
        "to": "5511999999999",
        "type": "text",
        "content": {
            "body": "Hello, World!"
        }
    }
    """
    try:
        data = await request.json()
        result = await whatsapp_api.send_message(
            to=data.get("to"),
            message_type=data.get("type", "text"),
            content=data.get("content", {})
        )
        return JSONResponse(content=result, status_code=200)
    except Exception as e:
        logger.error(f"Error sending message: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/send-template")
async def send_template(request: Request):
    """
    Send a message template to a WhatsApp number

    Request body:
    {
        "to": "5511999999999",
        "template_name": "hello_world",
        "language_code": "pt_BR",
        "components": []
    }
    """
    try:
        data = await request.json()
        result = await whatsapp_api.send_template(
            to=data.get("to"),
            template_name=data.get("template_name"),
            language_code=data.get("language_code", "pt_BR"),
            components=data.get("components", [])
        )
        return JSONResponse(content=result, status_code=200)
    except Exception as e:
        logger.error(f"Error sending template: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    import uvicorn
    port = int(os.getenv("PORT", 8000))
    uvicorn.run("main:app", host="0.0.0.0", port=port, reload=True)
