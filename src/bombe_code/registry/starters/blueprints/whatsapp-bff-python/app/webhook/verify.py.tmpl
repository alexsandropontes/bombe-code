from fastapi import Request, HTTPException
import os
import logging

logger = logging.getLogger(__name__)

async def verify_webhook(request: Request):
    """
    Verify webhook with WhatsApp Cloud API

    Meta sends a GET request with these parameters:
    - hub.mode: 'subscribe'
    - hub.challenge: random string to echo back
    - hub.verify_token: your configured verify token

    If verification succeeds, return the hub.challenge
    """
    verify_token = os.getenv("WHATSAPP_WEBHOOK_VERIFY_TOKEN")

    if not verify_token:
        logger.error("WHATSAPP_WEBHOOK_VERIFY_TOKEN not configured")
        raise HTTPException(status_code=500, detail="Verify token not configured")

    # Parse query parameters
    mode = request.query_params.get("hub.mode")
    challenge = request.query_params.get("hub.challenge")
    token = request.query_params.get("hub.verify_token")

    # Verify the token
    if mode == "subscribe" and token == verify_token:
        logger.info("Webhook verified successfully")
        return int(challenge) if challenge else ""
    else:
        logger.warning(f"Webhook verification failed: mode={mode}, token={token}")
        raise HTTPException(status_code=403, detail="Verification failed")
