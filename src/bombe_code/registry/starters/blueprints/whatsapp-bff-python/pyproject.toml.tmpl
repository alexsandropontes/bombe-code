[project]
name = "whatsapp-bff-python"
version = "1.0.0"
description = "WhatsApp BFF (Backend for Frontend) - Python FastAPI + WhatsApp Cloud API"
requires-python = ">=3.13"
dependencies = [
    "fastapi>=0.115.0",
    "uvicorn>=0.30.6",
    "httpx>=0.27.0",
    "pydantic>=2.0.0",
    "python-dotenv>=1.0.0"
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
