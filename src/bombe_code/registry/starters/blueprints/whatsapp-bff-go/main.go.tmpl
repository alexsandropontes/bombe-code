package main

import (
	"fmt"
	"log"
	"net/http"
	"os"

	"github.com/gin-gonic/gin"
	"github.com/joho/godotenv"
)

var (
	whatsappAPI *WhatsAppCloudAPI
)

func init() {
	// Load .env file
	if err := godotenv.Load(); err != nil {
		log.Println("⚠️  No .env file found")
	}

	// Initialize WhatsApp Cloud API client
	whatsappAPI = NewWhatsAppCloudAPI(
		os.Getenv("WHATSAPP_ACCESS_TOKEN"),
		os.Getenv("WHATSAPP_PHONE_NUMBER_ID"),
		os.Getenv("WHATSAPP_API_VERSION"),
	)
}

func main() {
	// Set Gin to release mode
	gin.Set(gin.ReleaseMode)

	r := gin.Default()

	// Health check endpoint
	r.GET("/health", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{
			"status":  "UP",
			"service": "WhatsApp BFF",
			"version": "1.0.0",
		})
	})

	// Webhook verification endpoint
	r.GET("/webhook", verifyWebhook)

	// Webhook endpoint to receive messages
	r.POST("/webhook", handleWebhook)

	// Send message endpoint
	r.POST("/api/send", sendMessage)

	// Send template endpoint
	r.POST("/api/send-template", sendTemplate)

	// Start server
	port := os.Getenv("PORT")
	if port == "" {
		port = "8000"
	}

	fmt.Printf("🚀 WhatsApp BFF Server running on port %s\n", port)
	fmt.Printf("📡 Webhook URL: http://localhost:%s/webhook\n", port)
	fmt.Printf("🔍 Health check: http://localhost:%s/health\n", port)

	if err := r.Run(":" + port); err != nil {
		log.Fatal("Failed to start server:", err)
	}
}
