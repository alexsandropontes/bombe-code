package middleware

import (
	"context"
	"net/http"
	"strings"
	"github.com/golang-jwt/jwt/v5"
	"os"
	"database/sql"
	"fmt"
)

func TenantContextMiddleware(db *sql.DB) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			authHeader := r.Header.Get("Authorization")
			if authHeader == "" { http.Error(w, "Token missing", http.StatusUnauthorized); return }

			tokenString := strings.Split(authHeader, "Bearer ")[1]
			token, _ := jwt.Parse(tokenString, func(token *jwt.Token) (interface{}, error) {
				return []byte(os.Getenv("JWT_SECRET")), nil
			})

			if claims, ok := token.Claims.(jwt.MapClaims); ok && token.Valid {
				tenantSlug := claims["tenant_slug"].(string)
				
				// Context Switch Physical
				_, err := db.Exec(fmt.Sprintf("SET search_path TO op_%s", tenantSlug))
				if err != nil { http.Error(w, "Invalid tenant context", http.StatusUnauthorized); return }

				ctx := context.WithValue(r.Context(), "tenant_slug", tenantSlug)
				next.ServeHTTP(w, r.WithContext(ctx))
			} else {
				http.Error(w, "Invalid token", http.StatusUnauthorized)
			}
		})
	}
}
